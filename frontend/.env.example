# ==============================================================================
# Emotion Intelligence Lab — Environment Configuration
# ==============================================================================

# ==============================================================================
# Emotion Intelligence Lab — Environment Configuration
# ==============================================================================

# Option 1: Local or Deployed FastAPI NLP Backend (100% Free & Self-Hosted)
# Defaults to http://127.0.0.1:8000 when running locally
FASTAPI_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Option 2: Default Cloud LLM — Groq (Ultra-Fast LLaMA 3.3, 100% Free)
# Get your free key at: https://console.groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# Option 3: Backup Cloud LLM — Google Gemini (100% Free, 1,500 reqs/day)
# Get your free key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# Option 4: Generic OpenAI (Optional)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
