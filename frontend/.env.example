# ==============================================================================
# Emotion Intelligence Lab — Environment Configuration
# ==============================================================================

# Option 1: Local or Deployed FastAPI NLP Backend (100% Free & Self-Hosted)
# Defaults to http://127.0.0.1:8000 when running locally
FASTAPI_URL=http://127.0.0.1:8000

# Option 2: 100% Free Cloud LLMs via OpenAI-Compatible Base URL
# ------------------------------------------------------------------------------
# Example A: Google Gemini 2.0 Flash (100% FREE from https://aistudio.google.com/)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=AIzaSy...

# Example B: Groq Ultra-Fast LLaMA 3.3 (100% FREE from https://console.groq.com/)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_...

# Example C: OpenRouter Free Models (100% FREE from https://openrouter.ai/)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_API_KEY=sk-or-v1-...

# Option 3: Standard OpenAI (Paid)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
